// skcms.nv — the count-min sketch, for counting how often.
//
// A count-min sketch counts occurrences of items in memory that does
// not grow with the number of distinct items (Cormode and
// Muthukrishnan, 2005).  It is a table of `depth` rows and `width`
// columns.  Each item is placed once per row, at a column that row's
// hash chooses, and the counter there is incremented.  An estimate is
// the smallest of the `depth` counters the item lands on, which is
// where the name comes from, and why the estimate can only be too high.
//
// The estimate is never below the true count, and it is above by more
// than `epsilon x total` with probability at most `delta`.  A caller
// can act on a low estimate with confidence and on a high one with
// caution, which is what a heavy-hitter detector, a per-key rate
// limiter and a cache admission policy need.
//
// The sketch does not remember items.  It answers about an item the
// caller names and cannot list what it has counted, so finding the top
// items needs a heap of candidates kept beside it.
//
// The caller hashes each item once to 64 bits.  Row `i` takes its
// column from that hash mixed with the row number by the SplitMix64
// finaliser, so the rows are independent of one another even when the
// caller's hash is weak in some of its bits.  The hash label works as
// in `skhll`.

use skfault

// The serialised form: the three bytes `SKC`, a version byte, the
// width and the depth as four bytes each, the total as eight, the
// label's length as two and the label in UTF-8, then every counter as
// eight bytes, row by row.  Every number is big-endian.
const HEADER: Int = 22
const FORM_VERSION: Int = 1

// A count-min sketch.
pub struct CmsSketch
    // Columns per row.  Sets the error: `epsilon` is about
    // `2 / width`.
    width: Int
    // Rows.  Sets the confidence: `delta` is about `0.5^depth`.
    depth: Int
    // The label the caller gave for the hash the sketch was fed
    // through.
    hash_id: Str
    // The counters, `depth * width` of them, row-major.
    counts: [Int]
    // Every increment the sketch has taken, which is what the error
    // bound is relative to.
    total: Int

// An empty sketch with an explicit table size.
//
// ```novo
// use skcms
//
// fn main() [io]
//     match skcms.new(2048, 5, "xxh3")
//         Ok(s)  => println("${s.width}")               // 2048
//         Err(f) => println(f.message())
// ```
pub fn new(width: Int, depth: Int, hash_id: Str) -> Result<CmsSketch, skfault.SkFault>
    if width < 1 or depth < 1
        return Err(SkDimensionNotPositive(width, depth))
    Ok(CmsSketch { width: width,
        depth: depth,
        hash_id: hash_id,
        counts: list.zeros(width * depth),
        total: 0 })

// An empty sketch sized from the error bound the caller wants.
//
// `epsilon` is how far above the truth an estimate may be, as a
// fraction of the total counted; `delta` is the probability that it is
// further.  The table is `ceil(2 / epsilon)` columns by
// `ceil(ln(1 / delta) / ln 2)` rows, which is the sizing of Cormode
// and Muthukrishnan's original paper.
//
// This is the constructor to prefer: the numbers a caller can reason
// about are the error and the confidence, not the width and the depth.
// An `epsilon` or a `delta` that sizes no table, such as a `delta` of
// `1.0` or more, is refused as `SkDimensionNotPositive`.
//
// ```novo
// use skcms
//
// fn main() [io]
//     match skcms.with_error(0.001, 0.01, "xxh3")
//         Ok(s)  => println("${s.depth}")               // 7
//         Err(f) => println(f.message())
// ```
pub fn with_error(epsilon: Float, delta: Float, hash_id: Str) -> Result<CmsSketch, skfault.SkFault>
    let width = if epsilon > 0.0
        math.ceil(2.0 / epsilon) as Int
    else
        0
    let depth = if delta > 0.0
        math.ceil(math.log(1.0 / delta) / math.log(2.0)) as Int
    else
        0
    new(width, depth, hash_id)

// The sketch with `count` more of an item.
//
// `count` may be any positive number, so a caller counting bytes or
// costs adds them in one call rather than one at a time.  A count below
// one adds nothing, since a negative count would break the promise that
// an estimate is never low.
//
// The sketch given is left unchanged.  Its counters are copied, so an
// add costs time in proportion to `width x depth`.
//
// ```novo
// use skcms
//
// fn main() [io]
//     match skcms.new(256, 4, "test")
//         Err(f) => println(f.message())
//         Ok(s)  =>
//             let once = skcms.add(s, bytes.from_str("/a"), 1, fake_hash)
//             println("${once.total}")                  // 1
//
// fn fake_hash(b: Bytes) -> Int
//     11
// ```
pub fn add(s: CmsSketch, item: Bytes, count: Int, hash: fn(Bytes) -> Int) -> CmsSketch
    add_hashed(s, hash(item), count)

// The sketch with `count` more of an already-hashed item.
//
// ```novo
// use skcms
//
// fn main() [io]
//     match skcms.new(256, 4, "xxh3")
//         Ok(s)  => println("${skcms.add_hashed(s, 981723, 1).total}")   // 1
//         Err(f) => println(f.message())
// ```
pub fn add_hashed(s: CmsSketch, hashed: Int, count: Int) -> CmsSketch
    if count < 1
        return s
    var counts = s.counts[:]
    for row in 0..s.depth
        let at = row * s.width + column(hashed, row, s.width)
        counts[at] = counts[at] + count
    CmsSketch { width: s.width,
        depth: s.depth,
        hash_id: s.hash_id,
        counts: counts,
        total: s.total + count }

// How often the sketch estimates it has seen an item.
//
// Never below the true count.  Above it by more than
// `error_bound(s) * total` with probability at most `1 - confidence(s)`.
//
// ```novo
// use skcms
//
// fn main() [io]
//     match skcms.new(256, 4, "test")
//         Err(f) => println(f.message())
//         Ok(s)  => println("${skcms.estimate(s, bytes.from_str("/a"), fake_hash)}")
//
// fn fake_hash(b: Bytes) -> Int
//     11
// ```
pub fn estimate(s: CmsSketch, item: Bytes, hash: fn(Bytes) -> Int) -> Int
    estimate_hashed(s, hash(item))

// How often the sketch estimates it has seen an already-hashed item.
//
// ```novo
// use skcms
//
// fn main() [io]
//     match skcms.new(256, 4, "xxh3")
//         Ok(s)  => println("${skcms.estimate_hashed(s, 981723)}")       // 0
//         Err(f) => println(f.message())
// ```
pub fn estimate_hashed(s: CmsSketch, hashed: Int) -> Int
    var least = s.counts[column(hashed, 0, s.width)]
    for row in 1..s.depth
        let c = s.counts[row * s.width + column(hashed, row, s.width)]
        if c < least
            least = c
    least

// How far above the true count an estimate may be, as a fraction of
// the total counted.
//
// `2 / width`, the `epsilon` of the sizing.
//
// ```novo
// use skcms
//
// fn main() [io]
//     match skcms.new(2000, 5, "xxh3")
//         Ok(s)  => println("${skcms.error_bound(s) == 0.001}")          // true
//         Err(f) => println(f.message())
// ```
pub fn error_bound(s: CmsSketch) -> Float
    2.0 / s.width as Float

// The probability that an estimate is within the error bound.
//
// `1 - 0.5^depth`.  Five rows give about 0.969, ten give about 0.999.
//
// ```novo
// use skcms
//
// fn main() [io]
//     match skcms.new(2000, 5, "xxh3")
//         Ok(s)  => println("${skcms.confidence(s) > 0.96}")             // true
//         Err(f) => println(f.message())
// ```
pub fn confidence(s: CmsSketch) -> Float
    1.0 - math.pow(0.5, s.depth as Float)

// The sketch that has counted everything both have.
//
// Two sketches of the same shape add counter by counter, and the
// result is exactly the sketch that would have counted both streams.
// Refused when the shapes or the hash labels differ.
//
// ```novo
// use skcms
//
// fn main() [io]
//     match skcms.new(256, 4, "xxh3")
//         Err(f) => println(f.message())
//         Ok(s)  =>
//             match skcms.merge(s, s)
//                 Ok(u)  => println("${u.total}")       // 0
//                 Err(f) => println(f.message())
// ```
pub fn merge(a: CmsSketch, b: CmsSketch) -> Result<CmsSketch, skfault.SkFault>
    if a.width != b.width or a.depth != b.depth
        return Err(SkShapeMismatch("${a.width}x${a.depth}", "${b.width}x${b.depth}"))
    if a.hash_id != b.hash_id
        return Err(SkHashMismatch(a.hash_id, b.hash_id))
    var counts = a.counts[:]
    for i in 0..list.len(counts)
        counts[i] = counts[i] + b.counts[i]
    Ok(CmsSketch { width: a.width,
        depth: a.depth,
        hash_id: a.hash_id,
        counts: counts,
        total: a.total + b.total })

// The sketch with every counter halved, rounding down.
//
// How a count-min sketch forgets: a stream that runs for a week
// otherwise answers about the whole week, and a caller that wants
// "recently" halves on a schedule it chooses.  This package reads no
// clock, so it cannot choose one.
//
// ```novo
// use skcms
//
// fn main() [io]
//     match skcms.new(256, 4, "xxh3")
//         Ok(s)  => println("${skcms.halve(s).total}")  // 0
//         Err(f) => println(f.message())
// ```
pub fn halve(s: CmsSketch) -> CmsSketch
    let counts = list.map(s.counts, c => c / 2)
    CmsSketch { width: s.width,
        depth: s.depth,
        hash_id: s.hash_id,
        counts: counts,
        total: s.total / 2 }

// The sketch as bytes, carrying its shape and hash label.
//
// ```novo
// use skcms
//
// fn main() [io]
//     match skcms.new(256, 4, "xxh3")
//         Ok(s)  => println("${bytes.len(skcms.to_bytes(s)) > 0}")
//         Err(f) => println(f.message())
// ```
pub fn to_bytes(s: CmsSketch) -> Bytes
    let label = bytes.from_str(s.hash_id)
    let n = bytes.len(label)
    let cells = s.width * s.depth
    var out = bytes.zeros(HEADER + n + 8 * cells)
    bytes.set_u8(out, 0, 'S')
    bytes.set_u8(out, 1, 'K')
    bytes.set_u8(out, 2, 'C')
    bytes.set_u8(out, 3, FORM_VERSION)
    bytes.set_u32_be(out, 4, s.width)
    bytes.set_u32_be(out, 8, s.depth)
    bytes.set_u64_be(out, 12, s.total)
    bytes.set_u16_be(out, 20, n)
    bytes.copy_into(out, HEADER, label, 0, n)
    for i in 0..cells
        bytes.set_u64_be(out, HEADER + n + 8 * i, s.counts[i])
    out

// A sketch read back from bytes.
//
// ```novo
// use skcms
//
// fn main() [io]
//     match skcms.from_bytes(bytes.from_str(""))
//         Ok(s)  => println("${s.total}")
//         Err(f) => println(f.message())
// ```
pub fn from_bytes(b: Bytes) -> Result<CmsSketch, skfault.SkFault>
    let size = bytes.len(b)
    if size < HEADER
        return Err(SkBadSerialisedForm("${size} bytes is shorter than the ${HEADER}-byte header"))
    if byte(b, 0) != 'S' or byte(b, 1) != 'K' or byte(b, 2) != 'C'
        return Err(SkBadSerialisedForm("the header does not begin with SKC"))
    if byte(b, 3) != FORM_VERSION
        return Err(SkBadSerialisedForm("form version ${byte(b, 3)} is not ${FORM_VERSION}"))
    let width = bytes.u32_be_at(b, 4) ?? 0
    let depth = bytes.u32_be_at(b, 8) ?? 0
    let total = bytes.u64_be_at(b, 12) ?? 0
    let n = bytes.u16_be_at(b, 20) ?? 0
    if width < 1 or depth < 1
        return Err(SkBadSerialisedForm("a table of width ${width} and depth ${depth}"))
    let cells = width * depth
    if size != HEADER + n + 8 * cells
        return Err(SkBadSerialisedForm("${size} bytes, where a ${width}x${depth} table and a ${n}-byte label need ${HEADER + n + 8 * cells}"))
    let label = bytes.to_str(bytes.slice(b, HEADER, HEADER + n))
    var counts = list.zeros(cells)
    for i in 0..cells
        counts[i] = bytes.u64_be_at(b, HEADER + n + 8 * i) ?? 0
    Ok(CmsSketch { width: width, depth: depth, hash_id: label, counts: counts, total: total })

// The column row `row` places a hash in: the SplitMix64 finaliser over
// the hash and the row number, reduced to `0 ..< width`.
@wrapping
fn column(hashed: Int, row: Int, width: Int) -> Int
    var z = hashed + (row + 1) * -7046029254386353131
    z = (z ^ (z >>> 30)) * -4658895280553007687
    z = (z ^ (z >>> 27)) * -7723592293110705685
    z = z ^ (z >>> 31)
    (z >>> 1) % width

// One byte of a buffer already checked to be long enough.
fn byte(b: Bytes, i: Int) -> Int
    bytes.byte_at(b, i) ?? 0
