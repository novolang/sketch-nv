// skreservoir.nv — reservoir sampling, for keeping a fair sample.
//
// A reservoir of capacity `k` holds a uniform random sample of `k`
// items from a stream of unknown length, in one pass, keeping nothing
// else.  This is Vitter's algorithm R ("Random sampling with a
// reservoir", 1985): the first `k` items go in, and item `n` after
// that replaces a random one with probability `k / n`.  Every item
// offered has the same chance of being in the sample at the end,
// whatever the length of the stream.
//
// It is the one structure in this package that keeps the items
// themselves.  A sketch answers a number, and a sample answers "show me
// some": a log pipeline keeping a hundred requests out of ten million,
// or a profiler keeping stacks.
//
// The randomness comes from the caller.  `offer` takes a uniform number
// in `0.0 ..< 1.0`, and `merge` takes a list of them, so this package
// declares no effect and draws nothing.  A test hands in the numbers it
// wants and gets a sample it can assert on.
//
// A merge is weighted by how many items each stream saw.  The sample of
// the stream that saw fewer items is offered to the other one item at a
// time, each item standing for `seen / sample size` of its stream's
// items, with the probability of keeping it scaled by that weight.  A
// reservoir that saw a million items therefore dominates one that saw
// ten.  This is the weighted update of Apache DataSketches' reservoir
// union.

use skfault

// The serialised form: the three bytes `SKR`, a version byte, the
// capacity as four bytes, the seen count as eight, the number of items
// held as four, then each item as its length in four bytes and its
// bytes.  Every number is big-endian.
const HEADER: Int = 20
const FORM_VERSION: Int = 1

// A reservoir sample.
pub struct RsSketch
    // How many items the reservoir holds at most.
    capacity: Int
    // How many items have been offered to it, which is what the
    // replacement probability is computed from.
    seen: Int
    // The sample itself, in no meaningful order.
    items: [Bytes]

// An empty reservoir.
//
// ```novo
// use skreservoir
//
// fn main() [io]
//     match skreservoir.new(100)
//         Ok(r)  => println("${skreservoir.seen_of(r)}")    // 0
//         Err(f) => println(f.message())
// ```
pub fn new(capacity: Int) -> Result<RsSketch, skfault.SkFault>
    if capacity < 1
        return Err(SkCapacityNotPositive(capacity))
    Ok(RsSketch { capacity: capacity, seen: 0, items: [] })

// The reservoir after one item has been offered to it.
//
// `uniform` is a random number in `0.0 ..< 1.0`, used only once the
// reservoir is full; before that the item is taken and the number
// ignored.  `needs_uniform` is the call that says so, for a caller
// that would rather not draw one it will not use.  Once the reservoir
// is full, a uniform outside `0.0 ..< 1.0` keeps nothing.
//
// The reservoir given is left unchanged, and the item is copied.
//
// ```novo
// use skreservoir
//
// fn main() [io]
//     match skreservoir.new(2)
//         Err(f) => println(f.message())
//         Ok(r)  =>
//             let one = skreservoir.offer(r, bytes.from_str("a"), 0.5)
//             println("${skreservoir.seen_of(one)}")        // 1
// ```
pub fn offer(r: RsSketch, item: Bytes, uniform: Float) -> RsSketch
    let seen = r.seen + 1
    var items = r.items[:]
    if list.len(items) < r.capacity
        list.push(items, bytes.clone(item))
    else if uniform >= 0.0 and uniform < 1.0
        let slot = (uniform * seen as Float) as Int
        if slot < r.capacity
            items[slot] = bytes.clone(item)
    RsSketch { capacity: r.capacity, seen: seen, items: items }

// Whether the next `offer` will consume its uniform.
//
// False while the reservoir is still filling.  A caller drawing random
// numbers from an expensive generator asks this first.
//
// ```novo
// use skreservoir
//
// fn main() [io]
//     match skreservoir.new(2)
//         Ok(r)  => println("${skreservoir.needs_uniform(r)}")   // false
//         Err(f) => println(f.message())
// ```
pub fn needs_uniform(r: RsSketch) -> Bool
    list.len(r.items) >= r.capacity

// The sample: every item the reservoir currently holds.
//
// In no meaningful order — the order is where replacements happened to
// land, and a caller that sorts it is asking a different question.
//
// ```novo
// use skreservoir
//
// fn main() [io]
//     match skreservoir.new(100)
//         Ok(r)  => println("${list.len(skreservoir.sample(r))}")    // 0
//         Err(f) => println(f.message())
// ```
pub fn sample(r: RsSketch) -> [Bytes]
    r.items[:]

// How many items have been offered.
//
// The population the sample stands for, and the number every reported
// proportion has to be scaled by: three errors in a sample of a
// hundred drawn from a million offers is thirty thousand errors.
//
// ```novo
// use skreservoir
//
// fn main() [io]
//     match skreservoir.new(100)
//         Ok(r)  => println("${skreservoir.seen_of(r)}")    // 0
//         Err(f) => println(f.message())
// ```
pub fn seen_of(r: RsSketch) -> Int
    r.seen

// Whether the reservoir holds as many items as it can.
//
// ```novo
// use skreservoir
//
// fn main() [io]
//     match skreservoir.new(100)
//         Ok(r)  => println("${skreservoir.is_full(r)}")    // false
//         Err(f) => println(f.message())
// ```
pub fn is_full(r: RsSketch) -> Bool
    list.len(r.items) >= r.capacity

// The chance that the next item offered will be kept.
//
// `1.0` until the reservoir is full, then `capacity / (seen + 1)`.
// What a caller reports as its sampling rate, and the number a
// downstream consumer needs to weight what it receives.
//
// ```novo
// use skreservoir
//
// fn main() [io]
//     match skreservoir.new(100)
//         Ok(r)  => println("${skreservoir.keep_probability(r)}")    // 1
//         Err(f) => println(f.message())
// ```
pub fn keep_probability(r: RsSketch) -> Float
    if list.len(r.items) < r.capacity
        return 1.0
    r.capacity as Float / (r.seen + 1) as Float

// A uniform sample of both streams.
//
// The merge is weighted by how many items each reservoir saw, so a
// reservoir that saw a million dominates one that saw ten — an
// unweighted merge would give the short stream half the sample and the
// result would not be uniform over anything.
//
// `uniforms` supplies the randomness: one per item held by the
// reservoir that saw fewer items.  A shorter list is refused with
// `SkTooFewUniforms` rather than reused, because reusing a number
// correlates the choices.  Refused with `SkShapeMismatch` when the
// capacities differ.
//
// ```novo
// use skreservoir
//
// fn main() [io]
//     match skreservoir.new(2)
//         Err(f) => println(f.message())
//         Ok(r)  =>
//             match skreservoir.merge(r, r, [0.1, 0.2])
//                 Ok(u)  => println("${skreservoir.seen_of(u)}")     // 0
//                 Err(f) => println(f.message())
// ```
pub fn merge(a: RsSketch, b: RsSketch, uniforms: [Float]) -> Result<RsSketch, skfault.SkFault>
    if a.capacity != b.capacity
        return Err(SkShapeMismatch("capacity ${a.capacity}", "capacity ${b.capacity}"))
    let base = if a.seen >= b.seen
        a
    else
        b
    let other = if a.seen >= b.seen
        b
    else
        a
    let needed = list.len(other.items)
    if list.len(uniforms) < needed
        return Err(SkTooFewUniforms(needed, list.len(uniforms)))
    var items = base.items[:]
    if needed == 0
        return Ok(RsSketch { capacity: base.capacity, seen: a.seen + b.seen, items: items })
    let weight = other.seen as Float / needed as Float
    var seen = base.seen as Float
    for i in 0..needed
        seen = seen + weight
        if list.len(items) < base.capacity
            list.push(items, bytes.clone(other.items[i]))
        else
            let keep = base.capacity as Float * weight / seen
            let u = uniforms[i]
            if u >= 0.0 and u < keep
                let slot = (u / keep * base.capacity as Float) as Int
                items[slot] = bytes.clone(other.items[i])
    Ok(RsSketch { capacity: base.capacity, seen: a.seen + b.seen, items: items })

// The reservoir as bytes, carrying its capacity and its seen count.
//
// ```novo
// use skreservoir
//
// fn main() [io]
//     match skreservoir.new(100)
//         Ok(r)  => println("${bytes.len(skreservoir.to_bytes(r)) > 0}")
//         Err(f) => println(f.message())
// ```
pub fn to_bytes(r: RsSketch) -> Bytes
    let n = list.len(r.items)
    var size = HEADER
    for item in r.items
        size = size + 4 + bytes.len(item)
    var out = bytes.zeros(size)
    bytes.set_u8(out, 0, 'S')
    bytes.set_u8(out, 1, 'K')
    bytes.set_u8(out, 2, 'R')
    bytes.set_u8(out, 3, FORM_VERSION)
    bytes.set_u32_be(out, 4, r.capacity)
    bytes.set_u64_be(out, 8, r.seen)
    bytes.set_u32_be(out, 16, n)
    var at = HEADER
    for item in r.items
        let len = bytes.len(item)
        bytes.set_u32_be(out, at, len)
        bytes.copy_into(out, at + 4, item, 0, len)
        at = at + 4 + len
    out

// A reservoir read back from bytes.
//
// ```novo
// use skreservoir
//
// fn main() [io]
//     match skreservoir.from_bytes(bytes.from_str(""))
//         Ok(r)  => println("${skreservoir.seen_of(r)}")
//         Err(f) => println(f.message())
// ```
pub fn from_bytes(b: Bytes) -> Result<RsSketch, skfault.SkFault>
    let size = bytes.len(b)
    if size < HEADER
        return Err(SkBadSerialisedForm("${size} bytes is shorter than the ${HEADER}-byte header"))
    if byte(b, 0) != 'S' or byte(b, 1) != 'K' or byte(b, 2) != 'R'
        return Err(SkBadSerialisedForm("the header does not begin with SKR"))
    if byte(b, 3) != FORM_VERSION
        return Err(SkBadSerialisedForm("form version ${byte(b, 3)} is not ${FORM_VERSION}"))
    let capacity = bytes.u32_be_at(b, 4) ?? 0
    let seen = bytes.u64_be_at(b, 8) ?? 0
    let n = bytes.u32_be_at(b, 16) ?? 0
    if capacity < 1 or n > capacity or seen < n
        return Err(SkBadSerialisedForm("capacity ${capacity}, ${seen} seen and ${n} held do not agree"))
    var items: [Bytes] = []
    var at = HEADER
    for i in 0..n
        if at + 4 > size
            return Err(SkBadSerialisedForm("item ${i} is cut off"))
        let len = bytes.u32_be_at(b, at) ?? 0
        if at + 4 + len > size
            return Err(SkBadSerialisedForm("item ${i} is cut off"))
        list.push(items, bytes.slice(b, at + 4, at + 4 + len))
        at = at + 4 + len
    if at != size
        return Err(SkBadSerialisedForm("${size - at} bytes follow the last item"))
    Ok(RsSketch { capacity: capacity, seen: seen, items: items })

// One byte of a buffer already checked to be long enough.
fn byte(b: Bytes, i: Int) -> Int
    bytes.byte_at(b, i) ?? 0
